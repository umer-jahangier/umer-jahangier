      "css": ".ds-field{background:#2340F0;color:#FFFFFF;padding:32px;width:416px;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif}.ds-field-fig{font:800 64px/1 'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-stretch:125%;letter-spacing:-1.5px}.ds-field-cap{margin-top:12px;font:600 17px/1.2 'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;color:#DDE2FF}.ds-field-bars{display:flex;align-items:flex-end;gap:2px;height:80px;margin-top:40px;border-bottom:1px solid rgba(255,255,255,.5)}.ds-field-bars i{display:block;width:14px;background:#FFFFFF}.ds-split{display:flex;gap:3px;height:12px;margin-top:40px}.ds-split b{background:#FFFFFF}.ds-split s{flex:1;border:1px solid #FFFFFF}.ds-split-lab{display:flex;justify-content:space-between;margin-top:14px;font:600 15px/1 'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif}.ds-split-lab em{font-style:normal;font-weight:400;color:#DDE2FF}"
